# =============================================================================
# EdVyro Internship Portal — Environment Variables Template
#
# SECURITY NOTICE:
# This file contains PLACEHOLDERS ONLY. Never commit actual secret keys or credentials!
# Copy this file to `.env` and supply actual values in your local/hosting environment.
# In Google AI Studio, configure API keys via the Secrets Manager panel.
# =============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database URL for SQLite persistence (Default: file:./data/internships.db)
# For remote Turso DB in production: libsql://[your-db].turso.io
DATABASE_URL=file:./data/internships.db

# Optional remote database token if using Turso/LibSQL cloud
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN_PLACEHOLDER"

# CORS Allowed Origin (Default: * or your deployed frontend domain)
CORS_ORIGIN=*

# Hosted App URL (AI Studio automatically injects this at runtime with Cloud Run URL)
APP_URL=http://localhost:3000

# Google AI Studio Gemini API Key (Injected automatically at runtime via Secrets Panel)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_PLACEHOLDER"
